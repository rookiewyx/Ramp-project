# 复制为 .env 后填写。.env 已加入 .gitignore，不要提交到 GitHub。

# ---------- 大模型（OpenAI 兼容接口） ----------
# 制度审核用的文本模型。用阿里云百炼时，地址和密钥与下面的视觉模型相同，模型填 qwen-plus：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
# 也可以用 DeepSeek 等其他 OpenAI 兼容服务
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 扫描件识别用的视觉模型，二选一：
#  A. AutoDL 上 vLLM 部署的 Qwen3-VL（可以是自己微调过的），用 SSH 隧道映射到本机 8001 端口
#  B. 阿里云百炼：VLM_BASE_URL 填控制台给出的 OpenAI 兼容地址（…/compatible-mode/v1），
#     VLM_MODEL=qwen3-vl-plus，VLM_API_KEY 填百炼的 API Key
VLM_BASE_URL=http://127.0.0.1:8001/v1
VLM_API_KEY=EMPTY
VLM_MODEL=Qwen/Qwen3-VL-2B-Instruct

# ---------- 存储（与 docker-compose.yml 保持一致） ----------
MYSQL_URL=mysql+pymysql://ramp:ramp_dev_pw@127.0.0.1:3306/ramp?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 审核服务（模块三） ----------
# 业务库：默认 SQLite；docker compose 起了 MySQL 后改成上面 MYSQL_URL 的值
DATABASE_URL=sqlite:///data/ramp.db
# 启动时自动把表结构升级到最新。部署时设为 false，由单独的 initdb 步骤升级（docker compose 已这样配置）
AUTO_MIGRATE=true
# 发票文件：local 存到 STORAGE_DIR；s3 存到任何 S3 兼容存储（docker compose 的 s3 部分是 RustFS）
STORAGE_BACKEND=local
STORAGE_DIR=data/objects
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=ramp
S3_SECRET_KEY=ramp_dev_secret
S3_BUCKET=ramp-invoices
# true：不需要 Redis 和 worker，审核在接口进程里同步执行（本地体验用）
TASK_EAGER=false
# 每个进程同时在途的模型请求上限，按模型服务的并发配额设置（0 表示不限）。
# 多个 worker 进程时，各进程之和不要超过配额，超了会被 429 拒绝、反复重试
VLM_MAX_CONCURRENCY=0
LLM_MAX_CONCURRENCY=0
# 发票查重登记：sql（数据库唯一索引）或 redis（SET NX）
REGISTRY_BACKEND=sql
MAX_UPLOAD_MB=10
# 接口鉴权，多个 key 用逗号分隔；留空表示不校验（只在本机开发时这样用）
API_KEYS=

# ---------- 调查 Agent ----------
# 转人工的单子先由 Agent 调用工具补证据（查预审批、出差申请、发票查验、商户登记，必要时追问员工），再重审
AGENT_ENABLED=true
AGENT_MAX_STEPS=8
# 公司系统的数据。真实部署对接 OA / 税务查验接口；这里用 JSON 文件模拟，留空则 Agent 只能追问员工
ENTERPRISE_FIXTURE=evalsets/enterprise_demo.json
# 追问员工后多少小时没答复就不再等（由 requeue 命令收尾）
AGENT_REPLY_TIMEOUT_H=72

# ---------- 可观测性：链路追踪 ----------
# true 后，API 和 worker 的链路发给 Jaeger（docker compose up -d jaeger，界面 http://127.0.0.1:16686）
OTEL_ENABLED=false
# otlp：发给 Jaeger；file：每个 span 一行 JSON 写到 OTEL_FILE，用 scripts/trace_report.py 汇总
OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=ramp-agent
OTEL_FILE=reports/traces.jsonl

# ---------- 国内镜像 ----------
HF_ENDPOINT=https://hf-mirror.com
